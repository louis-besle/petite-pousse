{
  "name": "petite-pousse",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:offline": "playwright test -c playwright.offline.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "referential:build": "tsx scripts/referential/build.ts",
    "referential:check": "tsx scripts/referential/check.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
